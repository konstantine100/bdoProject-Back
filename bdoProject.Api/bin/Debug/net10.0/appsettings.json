{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "my-connection-string"
  },
  "App": {
    "FrontendUrl": "http://localhost:4200"
  },
  "Jwt": {
    "Issuer": "my-issuer",
    "Audience": "my-clients",
    "SigningKey": "SuperSecretKeyThatIsAtLeast32CharsLong!!",
    "AccessTokenMinutes": 400,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
}
